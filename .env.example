# Copy to .env and adjust. All values have working defaults.

PORT=3000

# Public origin used to build shareable links. Must be the URL Discord will
# actually fetch, otherwise embeds point at localhost and silently fail.
STEGO_BASE_URL=http://localhost:3000

# Where uploads and stego.db live.
# On a Raspberry Pi this MUST point at the USB SSD, not the SD card —
# a file host writes constantly and will chew through SD flash.
# STEGO_DATA_DIR=/mnt/ssd/stego

# Max upload size in bytes (default 100 MB).
# Behind Cloudflare's free tier the effective ceiling is 100 MB regardless.
STEGO_MAX_FILE_SIZE=104857600

# Days before an upload is purged. 0 = keep forever.
STEGO_RETENTION_DAYS=0
