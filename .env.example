# Copy to .env and adjust.
#
# This file does double duty: `npm run start:dev` reads it for local
# development, and docker-compose.yml reads it on the Pi. Variables used only
# by one of the two are marked.

# Public origin used to build shareable links. Must be the URL Discord will
# actually fetch, otherwise embeds point at localhost and silently fail.
# Behind a Cloudflare Tunnel this is your tunnel hostname, https included.
STEGO_BASE_URL=http://localhost:3000

# Max upload size in bytes. Default here is 95 MB, which sits just under the
# 100 MB request-body cap Cloudflare's free plan enforces at the edge — larger
# uploads fail there before they ever reach the Pi, so let the app reject them
# with a useful error instead.
STEGO_MAX_FILE_SIZE=99614720

# Days before an upload is purged. 0 = keep forever.
STEGO_RETENTION_DAYS=0


# --- local development only -------------------------------------------------

PORT=3000

# Where uploads and stego.db live. Defaults to ./data.
# Under Docker this is ignored: the compose file always mounts the data volume
# at /data and sets this accordingly.
# STEGO_DATA_DIR=./data


# --- Docker on the Pi only --------------------------------------------------

# Host path bind-mounted to /data in the container. On a Raspberry Pi this MUST
# point at the USB SSD, not the SD card — a file host writes constantly and will
# chew through SD flash. The container runs as uid 1000, the same as the default
# Pi user, so a directory you own is writable as-is.
# STEGO_HOST_DATA_DIR=/mnt/ssd/stego

# Loopback port the app is published on. cloudflared dials this.
# STEGO_PORT=3000

# Pin a specific build instead of :latest — the workflow also tags every image
# with its short commit SHA, which is how you roll back.
# STEGO_IMAGE=ghcr.io/7qob/stego:sha-1a2b3c4

# Only for the containerised tunnel (docker-compose.tunnel.yml). The connector
# token from Zero Trust > Networks > Tunnels. Treat it as a password: anyone
# holding it can serve traffic on your hostname.
# TUNNEL_TOKEN=
