# Copy to .env and adjust.
#
# This file does double duty: `npm run start:dev` reads it for local
# development, and docker-compose.yml reads it on the Pi. Variables used only
# by one of the two are marked.

# Public origin used to build shareable links. Must be the URL Discord will
# actually fetch, otherwise embeds point at localhost and silently fail.
# Behind a Cloudflare Tunnel this is your tunnel hostname, https included.
STEGO_BASE_URL=http://localhost:3000

# Max upload size in bytes. Default here is 95 MB, which sits just under the
# 100 MB request-body cap Cloudflare's free plan enforces at the edge — larger
# uploads fail there before they ever reach the Pi, so let the app reject them
# with a useful error instead.
STEGO_MAX_FILE_SIZE=99614720

# Days before an upload is purged. 0 = keep forever.
STEGO_RETENTION_DAYS=0


# --- local development only -------------------------------------------------

PORT=3000

# Where uploads and stego.db live. Defaults to ./data.
# Under Docker this is ignored: the compose file always mounts the data volume
# at /data and sets this accordingly.
# STEGO_DATA_DIR=./data


# --- Docker on the Pi only --------------------------------------------------

# Host path bind-mounted to /data in the container. On a Raspberry Pi this MUST
# point at the USB SSD, not the SD card — a file host writes constantly and will
# chew through SD flash. The container runs as uid 1000, the same as the default
# Pi user, so a directory you own is writable as-is.
# STEGO_HOST_DATA_DIR=/mnt/ssd/stego

# Loopback port the app is published on. cloudflared dials this.
# STEGO_PORT=3000

# Pin a specific build instead of :latest — the workflow also tags every image
# with its short commit SHA, which is how you roll back.
# STEGO_IMAGE=ghcr.io/7qob/stego:sha-1a2b3c4

# Only for the containerised tunnel (docker-compose.tunnel.yml). The connector
# token from Zero Trust > Networks > Tunnels. Treat it as a password: anyone
# holding it can serve traffic on your hostname.
# TUNNEL_TOKEN=


# --- secrets ----------------------------------------------------------------

# The one secret everything else is derived from: at-rest encryption keys, the
# admin session signature, the per-link unlock cookie signature.
#
# `npm run secret` prints a good one.
#
# Unset, the app writes <data>/secret.key on first boot at mode 0600. That
# works with no setup, and it puts the key on the same disk as the data it
# protects — which is exactly the disk at-rest encryption is meant to protect
# against. Set this and keep it somewhere else.
#
# BACK IT UP. Lose it and every encrypted blob is unrecoverable. That is the
# point of it, not a flaw in it.
STEGO_SECRET=

# --- admin panel ------------------------------------------------------------

# With neither of these set, every admin route answers 404 — not 401 — so an
# instance without a panel does not advertise that the software has one.
#
# `npm run admin:hash` prints a hash. Prefer it to the plaintext below: an
# environment variable is readable by anything that can see the process.
STEGO_ADMIN_PASSWORD_HASH=
# STEGO_ADMIN_PASSWORD=

# Move the panel off /admin. Not a security control on its own — the password
# is — but it takes the instance out of every scanner wordlist at once.
# STEGO_ADMIN_PATH=/admin

# STEGO_ADMIN_SESSION_TTL_MS=43200000
# STEGO_ADMIN_MAX_ATTEMPTS=5
# STEGO_ADMIN_LOCKOUT_MS=900000

# --- privacy ----------------------------------------------------------------

# AES-256-CTR on disk under a key derived from STEGO_SECRET. A stolen or
# backed-up data volume is a directory of noise without it. Does nothing
# against anyone who has the running process — for that, use a private link.
# STEGO_ENCRYPT_AT_REST=1

# Strip EXIF/XMP/IPTC from uploaded and imported images. Works at the
# container level and never re-encodes, so pixels stay byte-identical and an
# LSB stego payload survives.
# STEGO_STRIP_METADATA=1

# Replace the uploader's filename with a neutral file.<ext>. Off by default
# because it makes downloads less useful; on, because
# "Q3-payroll-final.xlsx" names a company and a person before anyone opens it.
# STEGO_FORGET_FILENAMES=0

# X-Robots-Tag plus a deny-all robots.txt. A shared link in a search index has
# stopped being a shared link.
# STEGO_NOINDEX=1

# Redact file IDs, tokens, IP addresses and imported URLs out of the log.
# STEGO_SCRUB_LOGS=1

# Pad stored blobs up to a multiple of this many bytes so an exact file size
# on disk cannot fingerprint a known file. Costs disk, serves nothing extra.
# STEGO_PAD_TO_BYTES=0

# Ceiling on downstream caching, in seconds. A file with a delete timer is
# already capped at its own remaining TTL; this bounds the ones without a
# timer, so a manual delete reaches Cloudflare's edge within a day instead of
# a year. Raise it if you would rather have the bandwidth than the bound.
# STEGO_MAX_CACHE_SECONDS=86400

# --- link modes -------------------------------------------------------------

# STEGO_BURN_ENABLED=1            # burn-after-reading links
# STEGO_LINK_PASSWORD_ENABLED=1   # passphrase-gated links
# STEGO_E2E_ENABLED=1             # browser-side encryption, key in the fragment
# STEGO_UNLOCK_TTL_MS=3600000

# Public file ID length, in characters of a 32-symbol alphabet. 16 is ~80 bits.
# STEGO_ID_LENGTH=16

# --- rate limiting ----------------------------------------------------------

# Counted against a daily-rotating salted hash of the client address, held in
# memory and never written down.
# STEGO_RATE_LIMIT=1
# STEGO_RATE_WINDOW_MS=60000
# STEGO_RATE_UPLOADS=20
# STEGO_RATE_IMPORTS=10
# STEGO_RATE_READS=240
# STEGO_RATE_MISSES=30            # 404s. A flood of them is ID enumeration.
# STEGO_RATE_LOGINS=10

# Honour X-Forwarded-For. Set this ONLY behind a proxy you control. On a
# directly reachable origin, a client can forge a new one per request and walk
# through every limit above.
# STEGO_TRUST_PROXY=0

# Origins allowed to call the API from a browser. Empty disables CORS.
# STEGO_CORS_ORIGINS=

# quiet (default) | debug | error | silent
# STEGO_LOG_LEVEL=quiet
